# ============================================================
# افـنـدツ⁠يـنـا🥀🖤
# ENVIRONMENT CONFIGURATION
# FILE: .env.example
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NODE_ENV=development

APP_NAME=افـنـدツ⁠يـنـا🥀🖤

HOST=0.0.0.0

PORT=3000

TRUST_PROXY=false


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

API_PREFIX=/api

API_VERSION=v1

MAX_JSON_SIZE=1mb

MAX_URLENCODED_SIZE=1mb


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# POSTGRESQL
# ------------------------------------------------------------

DB_HOST=localhost

DB_PORT=5432

DB_NAME=afn_edinah

DB_USER=postgres

DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

DB_SSL=false

DB_POOL_MAX=20

DB_IDLE_TIMEOUT_MS=30000

DB_CONNECTION_TIMEOUT_MS=10000


# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS

JWT_EXPIRES_IN=7d

JWT_ISSUER=afn-edinah

JWT_AUDIENCE=afn-edinah-users


# ------------------------------------------------------------
# PASSWORD SECURITY
# ------------------------------------------------------------

BCRYPT_ROUNDS=12

REQUIRE_STRONG_PASSWORD=true


# ------------------------------------------------------------
# AUTHENTICATION / COOKIES
# ------------------------------------------------------------

COOKIE_NAME=afn_session

COOKIE_HTTP_ONLY=true

COOKIE_SECURE=false

COOKIE_SAME_SITE=lax

COOKIE_MAX_AGE_MS=604800000


# ------------------------------------------------------------
# SOCKET.IO
# ------------------------------------------------------------

SOCKET_PATH=/socket.io

SOCKET_PING_INTERVAL=25000

SOCKET_PING_TIMEOUT=20000


# ------------------------------------------------------------
# FILE UPLOADS
# ------------------------------------------------------------

UPLOAD_DIR=uploads

MAX_FILE_SIZE_MB=10

MAX_IMAGE_SIZE_MB=10

MAX_VIDEO_SIZE_MB=50

MAX_AUDIO_SIZE_MB=20

MAX_AVATAR_SIZE_MB=5

MAX_COVER_SIZE_MB=10


# ------------------------------------------------------------
# ALLOWED FILE TYPES
# ------------------------------------------------------------

ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

ALLOWED_VIDEO_TYPES=video/mp4,video/webm

ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/ogg,audio/wav


# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=300

AUTH_RATE_LIMIT_MAX=10

UPLOAD_RATE_LIMIT_MAX=30


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

ENABLE_HELMET=true

ENABLE_COMPRESSION=true

ENABLE_RATE_LIMIT=true

ENABLE_REQUEST_LOGGING=true

ENABLE_SECURITY_LOGGING=true


# ------------------------------------------------------------
# OWNER SYSTEM
# ------------------------------------------------------------

AUTO_FIRST_OWNER=true

ALLOW_OWNER_TRANSFER=false

ALLOW_OWNER_DEMOTION=false


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=info


# ------------------------------------------------------------
# PRODUCTION SETTINGS
# ------------------------------------------------------------

# عند تشغيل الموقع فعليًا على الخادم:
#
# NODE_ENV=production
# FRONTEND_URL=https://YOUR-DOMAIN
# CORS_ORIGINS=https://YOUR-DOMAIN
# DB_SSL=true
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=strict
#
# لا تضع أسرار الإنتاج داخل هذا الملف.
# استخدم ملف .env الحقيقي على الخادم.
