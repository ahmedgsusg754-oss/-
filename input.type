<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>افـنـدツينا🥀🖤 - الحساب</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Tahoma,Arial,sans-serif;
}

body{
  min-height:100vh;
  background:
    radial-gradient(circle at top right,#34153d 0%,transparent 35%),
    radial-gradient(circle at bottom left,#101f42 0%,transparent 40%),
    #080812;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.container{
  width:100%;
  max-width:470px;
}

.logo{
  text-align:center;
  margin-bottom:22px;
}

.logo h1{
  font-size:30px;
  margin-bottom:8px;
  background:linear-gradient(90deg,#ff4f9a,#a76cff,#4db8ff);
  -webkit-background-clip:text;
  color:transparent;
}

.logo p{
  color:#aaa;
  font-size:14px;
}

.card{
  background:rgba(20,20,34,.92);
  border:1px solid rgba(255,255,255,.09);
  border-radius:25px;
  padding:25px;
  box-shadow:0 20px 60px rgba(0,0,0,.45);
  backdrop-filter:blur(18px);
}

.tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  background:#10101c;
  padding:5px;
  border-radius:15px;
  margin-bottom:22px;
}

.tabs button{
  border:0;
  padding:12px;
  border-radius:11px;
  color:#aaa;
  background:transparent;
  cursor:pointer;
  font-size:14px;
}

.tabs button.active{
  color:#fff;
  background:linear-gradient(135deg,#9d4edd,#ff3f81);
}

.form{
  display:none;
}

.form.active{
  display:block;
}

h2{
  font-size:22px;
  margin-bottom:7px;
}

.subtitle{
  color:#9292a5;
  font-size:13px;
  margin-bottom:20px;
}

.field{
  margin-bottom:14px;
}

label{
  display:block;
  color:#ccc;
  font-size:13px;
  margin-bottom:7px;
}

input,
select{
  width:100%;
  border:1px solid rgba(255,255,255,.1);
  outline:none;
  background:#10101b;
  color:#fff;
  border-radius:13px;
  padding:14px;
  font-size:14px;
}

input:focus,
select:focus{
  border-color:#a85cff;
  box-shadow:0 0 0 3px rgba(168,92,255,.1);
}

.password-box{
  position:relative;
}

.password-box input{
  padding-left:48px;
}

.show-password{
  position:absolute;
  left:10px;
  top:50%;
  transform:translateY(-50%);
  border:0;
  background:none;
  color:#aaa;
  cursor:pointer;
  font-size:17px;
}

.main-btn{
  width:100%;
  border:0;
  border-radius:14px;
  padding:14px;
  margin-top:7px;
  color:white;
  font-size:15px;
  font-weight:bold;
  cursor:pointer;
  background:linear-gradient(135deg,#9d4edd,#ff3f81);
  box-shadow:0 10px 25px rgba(157,78,221,.25);
}

.main-btn:hover{
  filter:brightness(1.1);
}

.secondary{
  margin-top:13px;
  text-align:center;
}

.secondary button{
  border:0;
  background:none;
  color:#b877ff;
  cursor:pointer;
}

.forgot{
  display:block;
  text-align:left;
  border:0;
  background:none;
  color:#aaa;
  font-size:12px;
  cursor:pointer;
  margin-top:8px;
}

.message{
  display:none;
  padding:12px;
  border-radius:12px;
  margin-bottom:15px;
  font-size:13px;
}

.message.success{
  display:block;
  background:rgba(50,200,120,.1);
  color:#67e8a4;
  border:1px solid rgba(50,200,120,.2);
}

.message.error{
  display:block;
  background:rgba(255,70,100,.1);
  color:#ff8297;
  border:1px solid rgba(255,70,100,.2);
}

.owner-badge{
  display:none;
  text-align:center;
  margin-top:15px;
  padding:11px;
  border-radius:12px;
  background:linear-gradient(135deg,rgba(255,190,50,.12),rgba(255,80,140,.12));
  border:1px solid rgba(255,190,50,.2);
  color:#ffd66b;
  font-size:13px;
}

.note{
  margin-top:18px;
  text-align:center;
  color:#66677a;
  font-size:11px;
  line-height:1.7;
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">
    <h1>افـنـدツينا🥀🖤</h1>
    <p>مرحبًا بك في عالم افندينا</p>
  </div>

  <div class="card">

    <div class="tabs">
      <button id="loginTab" class="active" onclick="switchForm('login')">
        تسجيل الدخول
      </button>

      <button id="registerTab" onclick="switchForm('register')">
        إنشاء حساب
      </button>
    </div>

    <div id="message" class="message"></div>

    <!-- تسجيل الدخول -->
    <form id="loginForm" class="form active">

      <h2>تسجيل الدخول 👋</h2>
      <p class="subtitle">ادخل إلى حسابك وتابع عالم افندينا</p>

      <div class="field">
        <label>البريد الإلكتروني</label>
        <input
          id="loginEmail"
          type="email"
          placeholder="example@email.com"
          autocomplete="email"
          required
        >
      </div>

      <div class="field">
        <label>كلمة المرور</label>

        <div class="password-box">
          <input
            id="loginPassword"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          >

          <button
            type="button"
            class="show-password"
            onclick="togglePassword('loginPassword',this)"
          >👁</button>
        </div>
      </div>

      <button
        type="button"
        class="forgot"
        onclick="forgotPassword()"
      >
        نسيت كلمة المرور؟
      </button>

      <button class="main-btn" type="submit">
        دخول إلى الحساب
      </button>

      <div class="secondary">
        ليس لديك حساب؟
        <button type="button" onclick="switchForm('register')">
          إنشاء حساب
        </button>
      </div>

    </form>


    <!-- إنشاء الحساب -->
    <form id="registerForm" class="form">

      <h2>إنشاء حساب جديد ✨</h2>
      <p class="subtitle">أنشئ حسابك وابدأ رحلتك في افندينا</p>

      <div class="field">
        <label>اسم المستخدم</label>
        <input
          id="registerName"
          type="text"
          placeholder="اكتب اسمك"
          maxlength="30"
          autocomplete="name"
          required
        >
      </div>

      <div class="field">
        <label>البريد الإلكتروني</label>
        <input
          id="registerEmail"
          type="email"
          placeholder="example@email.com"
          autocomplete="email"
          required
        >
      </div>

      <div class="field">
        <label>العمر</label>
        <input
          id="registerAge"
          type="number"
          min="13"
          max="100"
          placeholder="العمر"
          required
        >
      </div>

      <div class="field">
        <label>الجنس</label>

        <select id="registerGender" required>
          <option value="">اختر الجنس</option>
          <option value="male">ذكر</option>
          <option value="female">أنثى</option>
        </select>
      </div>

      <div class="field">
        <label>كلمة المرور</label>

        <div class="password-box">
          <input
            id="registerPassword"
            type="password"
            placeholder="6 أحرف على الأقل"
            minlength="6"
            autocomplete="new-password"
            required
          >

          <button
            type="button"
            class="show-password"
            onclick="togglePassword('registerPassword',this)"
          >👁</button>
        </div>
      </div>

      <div class="field">
        <label>تأكيد كلمة المرور</label>

        <div class="password-box">
          <input
            id="registerConfirm"
            type="password"
            placeholder="أعد كتابة كلمة المرور"
            minlength="6"
            autocomplete="new-password"
            required
          >

          <button
            type="button"
            class="show-password"
            onclick="togglePassword('registerConfirm',this)"
          >👁</button>
        </div>
      </div>

      <button class="main-btn" type="submit">
        إنشاء الحساب
      </button>

      <div class="secondary">
        لديك حساب بالفعل؟
        <button type="button" onclick="switchForm('login')">
          تسجيل الدخول
        </button>
      </div>

    </form>

    <div id="ownerBadge" class="owner-badge">
      👑 حساب المالك — جميع صلاحيات الإدارة مفعّلة
    </div>

    <div class="note">
      بإنشاء حساب أنت توافق على شروط الاستخدام وسياسة الخصوصية.
    </div>

  </div>

</div>


<script>
/*
====================================================
 إعدادات النظام
====================================================

مهم:
لا تعتمد على هذا المتغير وحده لحماية حساب الـOwner
عند ربط الموقع بقاعدة بيانات حقيقية.

بعد إنشاء الـBackend سننقل التحقق الحقيقي إلى الخادم.
*/

const OWNER_EMAIL = "ضع-بريد-الاونر-هنا@example.com";


/*
====================================================
 تبديل النماذج
====================================================
*/

function switchForm(type){

  const loginForm = document.getElementById("loginForm");
  const registerForm = document.getElementById("registerForm");

  const loginTab = document.getElementById("loginTab");
  const registerTab = document.getElementById("registerTab");

  clearMessage();

  if(type === "login"){

    loginForm.classList.add("active");
    registerForm.classList.remove("active");

    loginTab.classList.add("active");
    registerTab.classList.remove("active");

  }else{

    loginForm.classList.remove("active");
    registerForm.classList.add("active");

    loginTab.classList.remove("active");
    registerTab.classList.add("active");
  }
}


/*
====================================================
 إظهار وإخفاء كلمة المرور
====================================================
*/

function togglePassword(id,button){

  const input = document.getElementById(id);

  if(input.type === "password"){
    input.type = "text";
    button.textContent = "🙈";
  }else{
    input.type = "password";
    button.textContent = "👁";
  }
}


/*
====================================================
 الرسائل
====================================================
*/

function showMessage(text,type="error"){

  const box = document.getElementById("message");

  box.textContent = text;
  box.className = "message " + type;
}

function clearMessage(){

  const box = document.getElementById("message");

  box.textContent = "";
  box.className = "message";
}


/*
====================================================
 قاعدة بيانات مؤقتة للنسخة التجريبية
====================================================

هذه ليست قاعدة بيانات حقيقية.

عند إنشاء الـBackend سيتم استبدالها بقاعدة البيانات.
====================================================
*/

function getUsers(){

  try{

    return JSON.parse(
      localStorage.getItem("afandina_users") || "[]"
    );

  }catch(error){

    return [];
  }
}

function saveUsers(users){

  localStorage.setItem(
    "afandina_users",
    JSON.stringify(users)
  );
}


/*
====================================================
 تحديد دور المستخدم
====================================================
*/

function getUserRole(email){

  const normalizedEmail = email.trim().toLowerCase();
  const ownerEmail = OWNER_EMAIL.trim().toLowerCase();

  if(
    ownerEmail &&
    ownerEmail !== "ضع-بريد-الاونر-هنا@example.com" &&
    normalizedEmail === ownerEmail
  ){

    return "owner";
  }

  return "user";
}


/*
====================================================
 إنشاء الحساب
====================================================
*/

document
.getElementById("registerForm")
.addEventListener("submit",function(event){

  event.preventDefault();

  clearMessage();

  const name =
    document.getElementById("registerName")
    .value.trim();

  const email =
    document.getElementById("registerEmail")
    .value.trim()
    .toLowerCase();

  const age =
    Number(document.getElementById("registerAge").value);

  const gender =
    document.getElementById("registerGender").value;

  const password =
    document.getElementById("registerPassword").value;

  const confirm =
    document.getElementById("registerConfirm").value;


  if(name.length < 2){

    showMessage("اكتب اسم مستخدم صحيح.");

    return;
  }


  if(!email.includes("@")){

    showMessage("أدخل بريدًا إلكترونيًا صحيحًا.");

    return;
  }


  if(age < 13 || age > 100){

    showMessage("العمر يجب أن يكون بين 13 و100.");

    return;
  }


  if(!gender){

    showMessage("اختر الجنس.");

    return;
  }


  if(password.length < 6){

    showMessage("كلمة المرور يجب أن تحتوي على 6 أحرف على الأقل.");

    return;
  }


  if(password !== confirm){

    showMessage("كلمتا المرور غير متطابقتين.");

    return;
  }


  const users = getUsers();


  const existingUser =
    users.find(user => user.email === email);


  if(existingUser){

    showMessage("هذا البريد مسجل بالفعل.");

    return;
  }


  const role = getUserRole(email);


  const user = {

    id:
      "user_" +
      Date.now() +
      "_" +
      Math.random()
      .toString(36)
      .substring(2,8),

    name:name,

    email:email,

    age:age,

    gender:gender,

    password:password,

    role:role,

    avatar:"",

    bio:"",

    posts:[],

    createdAt:new Date().toISOString(),

    status:"active",

    permissions:
      role === "owner"
      ?
      [
        "manage_users",
        "manage_rooms",
        "manage_messages",
        "manage_posts",
        "manage_reports",
        "manage_store",
        "manage_coins",
        "manage_gifts",
        "manage_settings",
        "manage_admins",
        "manage_roles",
        "manage_notifications",
        "manage_site",
        "view_statistics",
        "view_logs",
        "manage_bans",
        "manage_sessions",
        "delete_content",
        "owner_access"
      ]
      :
      [
        "profile",
        "posts",
        "chat"
      ]
  };


  users.push(user);

  saveUsers(users);


  localStorage.setItem(
    "afandina_current_user",
    JSON.stringify(user)
  );


  if(role === "owner"){

    document.getElementById("ownerBadge").style.display =
      "block";

    showMessage(
      "تم إنشاء حساب المالك بنجاح 👑",
      "success"
    );

  }else{

    showMessage(
      "تم إنشاء الحساب بنجاح 🎉",
      "success"
    );
  }


  /*
   لاحقًا:
   هنا سيتم تحويل المستخدم إلى الصفحة الرئيسية
   بعد ربط الموقع بالـBackend.
  */
});


/*
====================================================
 تسجيل الدخول
====================================================
*/

document
.getElementById("loginForm")
.addEventListener("submit",function(event){

  event.preventDefault();

  clearMessage();

  const email =
    document.getElementById("loginEmail")
    .value.trim()
    .toLowerCase();

  const password =
    document.getElementById("loginPassword")
    .value;


  if(!email || !password){

    showMessage("أدخل البريد وكلمة المرور.");

    return;
  }


  const users = getUsers();


  const user =
    users.find(
      item =>
        item.email === email &&
        item.password === password
    );


  if(!user){

    showMessage(
      "البريد الإلكتروني أو كلمة المرور غير صحيحة."
    );

    return;
  }


  if(user.status !== "active"){

    showMessage(
      "هذا الحساب موقوف حاليًا."
    );

    return;
  }


  /*
   إعادة تحديد الدور من إعدادات النظام
  */

  user.role = getUserRole(user.email);


  if(user.role === "owner"){

    user.permissions = [

      "manage_users",
      "manage_rooms",
      "manage_messages",
      "manage_posts",
      "manage_reports",
      "manage_store",
      "manage_coins",
      "manage_gifts",
      "manage_settings",
      "manage_admins",
      "manage_roles",
      "manage_notifications",
      "manage_site",
      "view_statistics",
      "view_logs",
      "manage_bans",
      "manage_sessions",
      "delete_content",
      "owner_access"
    ];

    document.getElementById("ownerBadge")
      .style.display = "block";

  }


  localStorage.setItem(
    "afandina_current_user",
    JSON.stringify(user)
  );


  showMessage(
    user.role === "owner"
      ? "تم تسجيل الدخول كمالك 👑"
      : "تم تسجيل الدخول بنجاح 👋",
    "success"
  );


  /*
   هنا سنربط الانتقال إلى index.html
   بعد الانتهاء من بقية ملفات الموقع.
  */
});


/*
====================================================
 استعادة كلمة المرور
====================================================
*/

function forgotPassword(){

  const email =
    document.getElementById("loginEmail")
    .value.trim();

  if(!email){

    showMessage(
      "اكتب بريدك الإلكتروني أولًا لاستعادة كلمة المرور."
    );

    return;
  }


  /*
   النسخة الحالية تجريبية.
   عند ربط Backend سنرسل رسالة استعادة
   حقيقية إلى البريد.
  */

  showMessage(
    "سيتم إرسال رابط استعادة كلمة المرور بعد ربط نظام البريد.",
    "success"
  );
}


/*
====================================================
 فحص الحساب الحالي
====================================================
*/

function getCurrentUser(){

  try{

    return JSON.parse(
      localStorage.getItem("afandina_current_user")
    );

  }catch(error){

    return null;
  }
}


/*
====================================================
 التحقق من صلاحية الـOwner
====================================================
*/

function isOwner(){

  const user = getCurrentUser();

  if(!user) return false;

  return user.role === "owner";
}


/*
====================================================
 فحص صلاحية معينة
====================================================
*/

function hasPermission(permission){

  const user = getCurrentUser();

  if(!user) return false;

  if(user.role === "owner") return true;

  return Array.isArray(user.permissions)
    && user.permissions.includes(permission);
}


/*
====================================================
 تجهيز بيانات يمكن لباقي الملفات استخدامها
====================================================
*/

window.AfandinaAuth = {

  getCurrentUser,

  isOwner,

  hasPermission,

  getUsers,

  saveUsers,

  getUserRole

};
</script>

</body>
</html>
