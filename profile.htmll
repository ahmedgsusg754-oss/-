  document.getElementById("genderInfo").textContent =
    currentUser.gender === "female"
      ? "أنثى"
      : "ذكر";

  document.getElementById("emailInfo").textContent =
    currentUser.email || "—";

  document.getElementById("roleInfo").textContent =
    currentUser.rol
