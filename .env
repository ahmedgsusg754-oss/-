NODE_ENV=development
APP_NAME=افـنـدツ⁠يـنـا🥀🖤
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false

API_PREFIX=/api
API_VERSION=v1
MAX_JSON_SIZE=1mb
MAX_URLENCODED_SIZE=1mb

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=afn_edinah
DB_USER=postgres
DB_PASSWORD=ضع_كلمة_مرور_قاعدة_البيانات_هنا
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=ضع_مفتاح_سري_عشوائي_طويل_هنا
JWT_EXPIRES_IN=7d
JWT_ISSUER=afn-edinah
JWT_AUDIENCE=afn-edinah-users

BCRYPT_ROUNDS=12
REQUIRE_STRONG_PASSWORD=true

COOKIE_NAME=afn_session
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=604800000

SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
MAX_AUDIO_SIZE_MB=20
MAX_AVATAR_SIZE_MB=5
MAX_COVER_SIZE_MB=10

ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/ogg,audio/wav

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30

ENABLE_HELMET=true
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMIT=true
ENABLE_REQUEST_LOGGING=true
ENABLE_SECURITY_LOGGING=true

AUTO_FIRST_OWNER=true
ALLOW_OWNER_TRANSFER=false
ALLOW_OWNER_DEMOTION=false

LOG_LEVEL=info
